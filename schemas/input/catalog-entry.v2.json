    "entry_id": {
      "maxLength": 100,
      "title": "Entry Id",
      "type": "string"
    },
    "entry_type": {
      "enum": [
        "project",
        "repository",
        "tool",
        "skill",
        "domain",
        "workflow",
        "rule",
        "document",
        "service",
        "integration",
        "source",
        "archive"
      ],
