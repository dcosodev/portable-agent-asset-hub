{
  "name": "portable-agent-asset-hub",
  "version": "0.3.0",
  "private": false,
  "license": "Apache-2.0",
  "author": "Daniel C. S.",
  "description": "Portable, auditable hub for versioned agent assets and runtime materialization.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.0.8",
  "files": [
    "dist/packages/baseline/**",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "schemas/input/**",
    "third_party/licenses/**"
  ],
  "scripts": {
    "lint": "eslint . --ignore-pattern 'dist/**' --ignore-pattern 'rejected/**' --ignore-pattern 'artifacts/**' --max-warnings 0",
    "typecheck": "tsc -b && pnpm --filter @portable-agent-asset-hub/graph-ui typecheck",
    "pretest": "pnpm build",
    "test": "vitest run && pnpm --filter @portable-agent-asset-hub/graph-ui test",
    "build": "node scripts/clean.mjs dist && tsc -b --force && node scripts/copy-sqlite-migrations.mjs && pnpm --filter @portable-agent-asset-hub/mcp build && pnpm --filter @portable-agent-asset-hub/graph-ui build",
    "graph-ui": "pnpm --filter @portable-agent-asset-hub/graph-ui build && pnpm --filter @portable-agent-asset-hub/graph-ui start",
    "graph-ui:test": "pnpm --filter @portable-agent-asset-hub/graph-ui test",
    "pack": "node scripts/root-package-pack.mjs",
    "audit": "pnpm audit --prod",
    "baseline:audit": "node scripts/baseline-audit.mjs",
    "baseline:gate": "node scripts/run-gate.mjs baseline",
    "storage:gate": "node scripts/run-gate.mjs storage",
    "package:repro": "node scripts/package-repro.mjs",
    "storage:external-install": "node scripts/external-install-storage.mjs",
    "skills:import": "node scripts/import-agent-skills.mjs",
    "memory:external-install": "node scripts/external-install-memory.mjs",
    "skills:db-only-e2e": "vitest run tests/e2e/db-only-skills.e2e.test.ts",
    "skills:verify-db-only": "node scripts/verify-db-only-skills.mjs",
    "storage:fresh-backup": "node scripts/fresh-backup.mjs",
    "memory:gate": "node scripts/run-gate.mjs memory",
    "profile:gate": "node scripts/run-gate.mjs profile",
    "catalog:gate": "node scripts/run-gate.mjs catalog",
    "catalog:fresh-process": "node scripts/catalog-fresh-process.mjs",
    "skills:export": "node scripts/export-agent-skills.mjs",
    "skills:export-focal": "vitest run tests/skill-export/export-focal.test.ts",
    "skills:export-full": "vitest run tests/skill-export",
    "sdk:generate": "node scripts/generate-sdks.mjs",
    "openapi:drift": "node scripts/check-openapi-drift.mjs",
    "openapi:gate": "node scripts/run-gate.mjs openapi",
    "mcp:gate": "node scripts/run-gate.mjs mcp",
    "hermes:gate": "node scripts/run-gate.mjs hermes",
    "openclaw:gate": "node scripts/run-gate.mjs openclaw",
    "migration:gate": "node scripts/run-gate.mjs migration",
    "hub:attach": "node scripts/attach-agent-hub.mjs",
    "hub:start": "node scripts/start-hub.mjs canonical",
    "hub:start:temp": "node scripts/start-hub.mjs temporary",
    "hub:backup": "node scripts/hub-backup.mjs",
    "relations:discover": "node scripts/relations.mjs discover",
    "relations:proposals": "node scripts/relations.mjs proposals",
    "observability:lint": "node scripts/observability-lint.mjs",
    "observability:contract": "pnpm vitest run tests/telemetry/privacy-contract.test.ts tests/telemetry/cardinality-contract.test.ts tests/telemetry/fail-open.test.ts tests/telemetry/config.test.ts tests/telemetry/noop.test.ts",
    "observability:cardinality": "pnpm vitest run tests/telemetry/cardinality-contract.test.ts",
    "observability:e2e": "pnpm vitest run tests/telemetry/otlp-process-smoke.test.ts",
    "observability:gate": "node scripts/observability-gate.mjs",
    "docker:contract": "node scripts/docker-stack-contract.mjs",
    "docker:smoke": "node scripts/docker-stack-smoke.mjs",
    "docker:gate": "pnpm docker:contract && pnpm docker:smoke",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "@portable-agent-asset-hub/core": "workspace:*",
    "@portable-agent-asset-hub/runtime-adapters": "workspace:*",
    "@portable-agent-asset-hub/skill-export": "workspace:*",
    "@portable-agent-asset-hub/storage-files": "workspace:*",
    "@portable-agent-asset-hub/storage-sqlite": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.5"
  }
}
